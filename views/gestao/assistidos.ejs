<%- include('inicio', { titulo: 'Consulta de assistidos' }) %>
<form method="GET" action="/assistidos" class="painel">
<div class="campos"><div><label for="busca">Nome ou CPF</label><input id="busca" name="busca" value="<%= busca %>" maxlength="100"></div><div><label for="status">Situação</label><select id="status" name="status"><option value="">Todas</option><% ['Ativo','Inativo'].forEach(s => { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div></div>
<div class="acoes"><button class="btn-atender" type="submit">Consultar</button><a href="/assistidos">Limpar filtros</a><a href="/cadastro">Cadastrar assistido</a></div></form>
<p><%= total %> assistido(s) encontrado(s).</p>
<div class="tabela"><table><thead><tr><th>Nome</th><th>CPF</th><th>Telefone</th><th>Situação</th><th>Ação</th></tr></thead><tbody>
<% assistidos.forEach(a => { %><tr><td><%= a.nome_assistido %></td><td><%= a._id %></td><td><%= a.telefone_assistido || '—' %></td><td><%= a.status || 'Ativo' %></td><td><a href="/assistidos/<%= encodeURIComponent(a._id) %>">Abrir ficha e editar</a></td></tr><% }) %>
<% if (!assistidos.length) { %><tr><td colspan="5">Nenhum assistido encontrado.</td></tr><% } %>
</tbody></table></div><div class="acoes">
<% if (numeroPagina > 1) { %><a href="/assistidos?busca=<%= encodeURIComponent(busca) %>&status=<%= encodeURIComponent(status) %>&pagina=<%= numeroPagina - 1 %>">Anterior</a><% } %>
<span>Página <%= numeroPagina %></span>
<% if (numeroPagina * 30 < total) { %><a href="/assistidos?busca=<%= encodeURIComponent(busca) %>&status=<%= encodeURIComponent(status) %>&pagina=<%= numeroPagina + 1 %>">Próxima</a><% } %></div>
<%- include('fim') %>
