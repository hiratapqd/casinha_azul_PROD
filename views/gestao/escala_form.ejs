<form class="escala-form" method="POST" action="<%= registro ? '/voluntarios/escala-data/' + registro._id : '/voluntarios/escala-data' %>">
<input type="hidden" name="data" value="<%= data %>"><div class="campos">
<div><label for="mod_<%= registro?._id || 'novo' %>">Modalidade</label><select id="mod_<%= registro?._id || 'novo' %>" name="modalidade" required><% modalidadesEscala.forEach(m => { %><option value="<%= m.id %>" <%= registro?.modalidade === m.id ? 'selected' : '' %>><%= m.nome %></option><% }) %></select></div>
<div><label for="inicio_<%= registro?._id || 'novo' %>">Início</label><input type="time" id="inicio_<%= registro?._id || 'novo' %>" name="inicio" value="<%= registro?.inicio || '' %>" required></div><div><label for="fim_<%= registro?._id || 'novo' %>">Fim</label><input type="time" id="fim_<%= registro?._id || 'novo' %>" name="fim" value="<%= registro?.fim || '' %>" required></div>
<div><label for="vol_<%= registro?._id || 'novo' %>">Voluntário original</label><select id="vol_<%= registro?._id || 'novo' %>" name="cpf_voluntario" required><option value="">Selecione</option><% voluntarios.filter(v => v.esta_ativo === 'Sim' || v._id === registro?.cpf_voluntario).forEach(v => { %><option value="<%= v._id %>" data-modalidades="<%= modalidadesEscala.filter(m => v.disponibilidade?.[m.disponibilidade]?.length > 0).map(m => m.id).join(',') %>" <%= registro?.cpf_voluntario === v._id ? 'selected' : '' %>><%= v.nome %> · <%= String(v._id).slice(-4) %></option><% }) %></select></div>
<div><label for="sub_<%= registro?._id || 'novo' %>">Substituto (opcional)</label><select id="sub_<%= registro?._id || 'novo' %>" name="cpf_substituto"><option value="">Sem substituição</option><% voluntarios.filter(v => v.esta_ativo === 'Sim' || v._id === registro?.cpf_substituto).forEach(v => { %><option value="<%= v._id %>" data-modalidades="<%= modalidadesEscala.filter(m => v.disponibilidade?.[m.disponibilidade]?.length > 0).map(m => m.id).join(',') %>" <%= registro?.cpf_substituto === v._id ? 'selected' : '' %>><%= v.nome %> · <%= String(v._id).slice(-4) %></option><% }) %></select></div>
<div><label for="status_<%= registro?._id || 'novo' %>">Situação</label><select id="status_<%= registro?._id || 'novo' %>" name="status"><% ['Confirmado','Ausente'].forEach(s => { %><option <%= (registro?.status || 'Confirmado') === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div></div>
<label for="motivo_<%= registro?._id || 'novo' %>">Motivo da substituição</label><input id="motivo_<%= registro?._id || 'novo' %>" name="motivo_substituicao" maxlength="500" value="<%= registro?.motivo_substituicao || '' %>">
<label for="obs_<%= registro?._id || 'novo' %>">Observações</label><textarea id="obs_<%= registro?._id || 'novo' %>" name="observacoes" maxlength="1000"><%= registro?.observacoes || '' %></textarea>
<div class="acoes"><button type="submit" class="btn-atender btn-success"><%= registro ? 'Salvar alterações / substituição' : 'Adicionar à escala' %></button></div></form>
