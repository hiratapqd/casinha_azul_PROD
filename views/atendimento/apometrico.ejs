<%- include('../partials/header') %>
<link rel="stylesheet" href="/styles/styles.css">

<main class="hero">
    <h1>Ficha de Atendimento - Apometria</h1>
    
    <form action="/atendimento/salvar" method="POST" class="form-container ficha-apometria" id="atendimentoForm">
        <input type="hidden" name="tipo" value="apometria">
        <input type="hidden" name="idSolicitacao" id="idSolicitacao">
        
        <div class="form-row">
            <div class="form-group campo-recuo">
                <label>Data:</label>
                <input type="date" name="data" id="campo_data" required>
            </div>
            <div class="form-group flex-2">
                <label>CPF do atendido:</label>
                <input type="text" id="cpf_assistido" name="cpf_assistido" placeholder="Apenas numeros" required autocomplete="off" inputmode="numeric" maxlength="14">
            </div>
        </div>

        <div class="form-row">
            <div class="form-group campo-recuo">
                <label>Nome do atendido:</label>
                <input type="text" name="nome_assistido" id="campo_nome" required>
            </div>
            <div class="form-group">
                <label>Idade:</label>
                <input type="text" name="idade_assistido" id="campo_idade">
            </div>
            <div class="form-group">
                <label>Religiao:</label>
                <input type="text" name="religiao_assistido" id="campo_religiao">
            </div>
        </div>

        <div class="terapeuta-beneficiario-linha">
            <div class="form-group terapeuta-selecao">
                <%- include('terapeuta') %>
            </div>
            <label class="opcao-beneficiario"><input type="checkbox" name="para_terceiro" id="para_terceiro"> Atendimento em intenção de outra pessoa</label>
        </div>

        <div class="form-group apometria-beneficiario">
            <div id="dados_beneficiario" hidden>
                <br>
                <p>O atendido é quem compareceu à apometria e fará os passes. Informe abaixo o assistido beneficiado. Quando marcar GAPPUS, os dois serão incluídos na lista do grupo.</p>
                <br>
                <div class="form-row"><div class="form-group"><label for="beneficiario_nome">Nome do assistido beneficiado:</label><input id="beneficiario_nome" name="beneficiario_nome" maxlength="150"></div>
                <div class="form-group"><label for="beneficiario_cpf">CPF do assistido (opcional):</label><input id="beneficiario_cpf" name="beneficiario_cpf" inputmode="numeric" maxlength="14"></div>
                <div class="form-group"><label for="beneficiario_parentesco">Relação com o atendido:</label><input id="beneficiario_parentesco" name="beneficiario_parentesco" maxlength="80" placeholder="Ex.: filho, amigo"></div></div>
                <input type="hidden" name="beneficiario_id" id="beneficiario_id">
                <button type="button" id="buscar_beneficiario" class="btn-atender">Buscar pessoa já cadastrada</button>
                <div id="resultados_beneficiario" class="resultados-beneficiario"></div>
                <p id="feedback_beneficiario" role="status"></p>
            </div>
        </div>

        <div class="plano-atendimento-linha">
            <label for="plano_atendimento">Plano de atendimento:</label>
            <select id="plano_atendimento" name="plano_atendimento" required>
                <% (typeof planosAtendimento === 'undefined' ? [] : planosAtendimento).forEach(p => { %>
                <option value="<%= p.id %>" <%= p.id === 'passes' ? 'selected' : '' %>><%= p.nome %><%= p.fixo ? '' : ' — ' + p.descricao %></option>
                <% }) %>
            </select>
            <div class="acompanhamentos-adicionais" role="group" aria-label="Acompanhamentos adicionais">
                <label><input type="checkbox" name="homeopatia_indicada"> Homeopatia</label>
                <label><input type="checkbox" name="gappus_indicado"> GAPPUS</label>
            </div>
        </div>
        <div class="form-group">
            <label for="data_retorno">Data esperada de retorno (opcional):</label>
            <input type="date" name="data_retorno" id="data_retorno">
        </div>
        <p></p>
        <br>
        <div class="form-group">
            <label>Evolução do Atendimento:</label>
            <textarea name="observacoes" id="descricao_atendimento" rows="5" required></textarea>
        </div>
        <br><br>
        <button type="submit" class="btn-atender btn-success">Finalizar Atendimento</button>
    </form><br><br>

    <hr>
    <h3>Historico de Atendimentos</h3>
    <table class="table-historico">
        <thead>
            <tr>
                <th>Data</th>
                <th>Terapeuta</th>
                <th>Observacao</th>
            </tr>
        </thead>
        <tbody id="tabela-corpo">
            <tr><td colspan="3">Aguardando CPF...</td></tr>
        </tbody>
    </table>
</main>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/apometriaBeneficiario.js"></script>
<script>
    const dataHoje = CasinhaDatas.hojeLocal();
    document.getElementById('data_retorno').min = CasinhaDatas.somarDiasISO(dataHoje, 1);
    document.getElementById('campo_data').value = dataHoje;
    const campoCpf = document.getElementById('cpf_assistido');
    let ultimoCpfSemCadastroAlertado = '';
    let ultimoCpfIncompletoAlertado = '';

    function normalizarCpf(valor) {
        return (valor || '').replace(/\D/g, '');
    }

    function cpfTem11Digitos(valor) {
        return normalizarCpf(valor).length === 11;
    }

    async function buscarAssistidoPorCpf(cpf) {
        const resposta = await fetch(`/api/dados-assistido/${cpf}`);
        if (!resposta.ok) {
            return null;
        }

        return resposta.json();
    }

    function calcularIdade(dataNasc) {
        return CasinhaDatas.calcularIdade(dataNasc);
    }

    function escaparHtml(valor) {
        const elemento = document.createElement('span');
        elemento.textContent = valor || '';
        return elemento.innerHTML;
    }

    function renderizarTabela(lista) {
        const corpo = document.getElementById('tabela-corpo');
        if (!lista || lista.length === 0) {
            corpo.innerHTML = '<tr><td colspan="3">Nenhum historico encontrado.</td></tr>';
            return;
        }
        corpo.innerHTML = lista.map(item => `
            <tr>
                <td>${CasinhaDatas.formatarData(item.data)}</td>
                <td>${item.voluntario || '-'}</td>
                <td>${item.observacoes || '-'}${item.plano_atendimento ? '<p>Plano de atendimento: ' + escaparHtml(item.plano_atendimento.nome) + '</p>' : ''}${item.data_retorno ? '<p>Data esperada de retorno: ' + CasinhaDatas.formatarData(item.data_retorno) + '</p>' : ''}</td>
            </tr>
        `).join('');
    }

    campoCpf.addEventListener('blur', async (e) => {
        const cpf = normalizarCpf(e.target.value);
        if (!cpfTem11Digitos(cpf)) {
            if (cpf.length > 0 && ultimoCpfIncompletoAlertado !== cpf) {
                ultimoCpfIncompletoAlertado = cpf;
                await Swal.fire('CPF incompleto', 'Informe um CPF com 11 digitos.', 'warning');
            }
            return;
        }

        ultimoCpfIncompletoAlertado = '';
        ultimoCpfSemCadastroAlertado = '';

        document.getElementById('idSolicitacao').value = `${cpf}_${dataHoje}`;

        try {
            const assistido = await buscarAssistidoPorCpf(cpf);
            if (!assistido) {
                document.getElementById('campo_nome').value = '';
                document.getElementById('campo_religiao').value = '';
                document.getElementById('campo_idade').value = '';
                renderizarTabela([]);
                if (ultimoCpfSemCadastroAlertado !== cpf) {
                    ultimoCpfSemCadastroAlertado = cpf;
                    await Swal.fire('Assistido não encontrado', 'Este CPF ainda não está cadastrado. Faça o cadastro antes de registrar o atendimento.', 'warning');
                }
                return;
            }

            ultimoCpfSemCadastroAlertado = '';
            document.getElementById('campo_nome').value = assistido.nome_assistido || '';
            document.getElementById('campo_religiao').value = assistido.religiao_assistido || '';
            document.getElementById('campo_idade').value = calcularIdade(assistido.data_nascimento_assistido);

            const respB = await fetch(`/api/historico/apometria/${cpf}`);
            if (respB.ok) {
                const dataRes = await respB.json();

                if (dataRes.queixa_atual) {
                    const campoObs = document.getElementById('descricao_atendimento');
                    const textoQueixa = `RELATO NA TRIAGEM:\n${dataRes.queixa_atual}\n-----------------------------\nORIENTACOES:\n`;

                    if (campoObs.value.trim() === '') {
                        campoObs.value = textoQueixa;
                    }
                }
                renderizarTabela(dataRes.historico || []);
            }
        } catch (err) {
            console.error('Erro na busca:', err);
        }
    });

    document.getElementById('atendimentoForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = e.target.querySelector('button[type="submit"]');

        if (!cpfTem11Digitos(campoCpf.value)) {
            await Swal.fire('CPF invalido', 'Informe um CPF com 11 digitos antes de finalizar.', 'warning');
            campoCpf.focus();
            return;
        }

        btn.disabled = true;

        try {
            const assistido = await buscarAssistidoPorCpf(normalizarCpf(campoCpf.value));
            if (!assistido) {
                await Swal.fire('Assistido nao encontrado', 'Este CPF ainda nao esta cadastrado. Faca o cadastro antes de finalizar o atendimento.', 'warning');
                campoCpf.focus();
                btn.disabled = false;
                return;
            }

            ultimoCpfSemCadastroAlertado = '';
            const formData = new URLSearchParams(new FormData(e.target));
            const resp = await fetch(e.target.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: formData
            });

            if (resp.ok) {
                const resultado = await resp.json();
                const mensagem = `Apometria salva.${resultado.encaminhadoPasse ? ' Assistido encaminhado para o Passe!' : ''}`;
                await Swal.fire('Sucesso', mensagem, 'success');
                window.location.href = '/fila-atendimento';
            } else {
                const erro = await resp.json().catch(() => null);
                throw new Error(erro?.mensagem || 'Falha ao salvar atendimento.');
            }
        } catch (err) {
            Swal.fire('Erro', err.message || 'Falha ao salvar atendimento.', 'error');
            btn.disabled = false;
        }
    });
</script>

<%- include('../partials/footer') %>
