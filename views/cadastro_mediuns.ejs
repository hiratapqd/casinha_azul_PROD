<%- include('partials/header') %>
    <link rel="stylesheet" href="/styles/styles.css">
<main class="hero">
    <h1>Cadastro dos mediuns</h1>
    <!-- <form action="/medium/novo" method="POST" class="form-container"> -->
    <form id="formVoluntario" action="/medium/novo" method="POST" class="form-container">
        <input type="hidden" id="forceUpdate" name="forceUpdate" value="false">
    <div class="form-row">
        <div class="form-group">
            <label for="cpf">CPF:</label>
            <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" inputmode="numeric" autocomplete="off" required>
            <small id="cpfStatus" class="texto-apoio" role="status" aria-live="polite"></small>
        </div><br>

        <div class="form-group">
            <label for="nome">Nome Completo:</label>
            <input type="text" id="nome" name="nome" required>
        </div><br>
    </div><br>
    <div class="form-row">
        <div class="form-group">
            <label for="telefone">Telefone/WhatsApp:</label>
            <input type="tel" id="telefone" name="telefone">
        </div><br>

        <div class="form-group">
            <label for="email">E-mail:</label>
            <input type="email" id="email" name="email">
        </div><br>
    </div><br>
        <div class="form-group">
            <label for="mediunidade">Mediunidade:</label>
            <input type="text" id="mediunidade" name="mediunidade">
            <label for="mediunidade">separe por vigula no caso de mais de uma</label>
        </div><br>

<div class="disponibilidade-secao">
    <h2>Disponibilidade por Modalidade</h2>
    <p>Selecione os dias da semana para cada atividade que deseja realizar:</p>

    <% 
        const modalidades = [
            { id: 'apometria', label: 'Apometria' },
            { id: 'reiki', label: 'Reiki' },
            { id: 'auriculo', label: 'Aurículo' },
            { id: 'maos', label: 'Mãos Sem Fronteiras' },
            { id: 'homeopatia', label: 'Homeopatia' },
            { id: 'cantina', label: 'Cantina' },
            { id: 'passe', label: 'Passe' },
            { id: 'gappus', label: 'GAPPUS' },
            { id: 'mesa', label: 'Mesa' }
        ];
        const dias = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'];
    %>

    <div class="grade-container">
        <% modalidades.forEach(mod => { %>
            <div class="linha-modalidade">
                <span class="label-modalidade"><%= mod.label %></span>
                <div class="checkbox-group">
                    <% dias.forEach(dia => { %>
                        <label class="check-item">
                            <!-- <input type="checkbox" name="voluntario_<%= mod.id %>_dias" value="<%= dia.toLowerCase() %>"> -->
                             <input type="checkbox" name="disp_<%= mod.id %>" value="<%= dia.toLowerCase() %>">
                            <span><%= dia %></span>
                        </label>
                    <% }) %>
                </div>
            </div>
        <% }) %>
    </div>
</div>

    </div><br>
        <button type="submit" id="botaoSalvar" class="btn-atender btn-success">Finalizar Cadastro do medium</button>
    </form>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    const form = document.getElementById('formVoluntario');
    const cpfInput = document.getElementById('cpf');
    const cpfStatus = document.getElementById('cpfStatus');
    const forceUpdateInput = document.getElementById('forceUpdate');
    const botaoSalvar = document.getElementById('botaoSalvar');
    const terapias = ['apometria', 'reiki', 'auriculo', 'maos', 'homeopatia', 'passe', 'gappus', 'cantina', 'mesa'];
    let sequenciaBusca = 0;

    function normalizarCpf(valor) {
        return (valor || '').replace(/\D/g, '');
    }

    function definirModoEdicao(emEdicao) {
        forceUpdateInput.value = emEdicao ? 'true' : 'false';
        botaoSalvar.textContent = emEdicao ? 'Atualizar cadastro do medium' : 'Finalizar Cadastro do medium';
    }

    function limparDadosVoluntario() {
        ['nome', 'telefone', 'email', 'mediunidade'].forEach(id => {
            document.getElementById(id).value = '';
        });
        form.querySelectorAll('input[name^="disp_"]').forEach(checkbox => {
            checkbox.checked = false;
        });
    }

    function preencherDadosVoluntario(voluntario) {
        document.getElementById('nome').value = voluntario.nome || '';
        document.getElementById('telefone').value = voluntario.telefone || '';
        document.getElementById('email').value = voluntario.email || '';
        document.getElementById('mediunidade').value = voluntario.mediunidade || '';

        terapias.forEach(terapia => {
            const dias = voluntario.disponibilidade?.[terapia] || [];
            const diasSelecionados = Array.isArray(dias) ? dias : [dias];

            form.querySelectorAll(`input[name="disp_${terapia}"]`).forEach(checkbox => {
                checkbox.checked = diasSelecionados.includes(checkbox.value);
            });
        });
    }

    async function buscarVoluntario() {
        const cpf = normalizarCpf(cpfInput.value);
        const buscaAtual = ++sequenciaBusca;

        definirModoEdicao(false);
        cpfStatus.textContent = '';

        if (cpf.length !== 11) {
            botaoSalvar.disabled = false;
            return;
        }

        botaoSalvar.disabled = true;
        cpfStatus.textContent = 'Buscando cadastro...';

        try {
            const resposta = await fetch(`/api/dados-voluntario/${cpf}`);
            if (buscaAtual !== sequenciaBusca) return;

            if (resposta.status === 404) {
                limparDadosVoluntario();
                cpfStatus.textContent = 'CPF ainda não cadastrado.';
                return;
            }

            if (!resposta.ok) {
                throw new Error('Falha ao buscar voluntário');
            }

            const voluntario = await resposta.json();
            if (buscaAtual !== sequenciaBusca) return;

            preencherDadosVoluntario(voluntario);
            definirModoEdicao(true);
            cpfStatus.textContent = 'Cadastro e disponibilidade carregados.';
        } catch (err) {
            console.error('Erro na busca do voluntário:', err);
            cpfStatus.textContent = 'Não foi possível consultar este CPF.';
        } finally {
            if (buscaAtual === sequenciaBusca) {
                botaoSalvar.disabled = false;
            }
        }
    }

    cpfInput.addEventListener('input', buscarVoluntario);

    form.addEventListener('submit', async (e) => {
        e.preventDefault(); // Impede o envio padrão que causa a página branca
        
        const formData = new FormData(form);
        const dados = Object.fromEntries(formData.entries());

        // Captura manual das disponibilidades para garantir o formato de Array no MongoDB
        terapias.forEach(terapia => {
            // Busca pelos checkboxes que agora seguem o padrão name="disp_terapia"
            const marcados = Array.from(form.querySelectorAll(`input[name="disp_${terapia}"]:checked`))
                                  .map(cb => cb.value);
            dados[`disp_${terapia}`] = marcados; 
        });

        try {
            const resposta = await fetch('/medium/novo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(dados)
            });

            const resultado = await resposta.json();

            if (resultado.status === 'conflito') {
                Swal.fire({
                    title: 'CPF já cadastrado!',
                    text: "Deseja atualizar os dados deste voluntário?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Sim, atualizar!',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        forceUpdateInput.value = 'true';
                        form.requestSubmit(); // Reenvia o formulário com o flag de atualização
                    }
                });
            } else if (resultado.status === 'sucesso') {
                Swal.fire('Sucesso!', 'Dados gravados com sucesso.', 'success')
                    .then(() => window.location.href = '/cadastro_mediuns');
            } else {
                Swal.fire('Erro!', resultado.mensagem || 'Não foi possível salvar os dados.', 'error');
            }
        } catch (err) {
            console.error("Erro no envio:", err);
            Swal.fire('Erro!', 'Falha ao comunicar com o servidor.', 'error');
        }
    });
</script>

</main>
<%- include('partials/footer') %>
